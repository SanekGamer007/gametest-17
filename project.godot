; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

instance_dock/scene_data_file="res://InstanceDockSceneData.txt"
instance_dock/preview_resolution=Vector2i(64, 64)

[application]

config/name="GAMETEST_17"
run/main_scene="uid://dq6b2qk0k0hcr"
config/features=PackedStringArray("4.5", "Forward Plus")
run/max_fps=30
boot_splash/fullsize=false
boot_splash/use_filter=false
boot_splash/image="uid://dgtc5ucqlkayo"
config/icon="uid://c0f0w0c32g4a2"
boot_splash/minimum_display_time=3000
boot_splash/minimum_display_time.debug=0

[autoload]

GlobalVars="*res://global/global_vars.gd"
SceneManager="*res://global/scene_manager/scene_manager.tscn"
Tools="*res://global/tools.gd"
Fullscreen="*res://global/fullscreen.gd"
SettingsManager="*res://global/settings_manager.gd"
procam="*res://addons/ProCam2D/scripts/autoload.gd"
SaveManager="*res://global/save_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=480
window/size/resizable=false
window/size/borderless=true
window/stretch/mode="viewport"
window/size/viewport_width.release=480
window/size/viewport_height.release=92

[dotnet]

project/assembly_name="GAMETEST_17"

[editor_plugins]

enabled=PackedStringArray("res://addons/GDQuest_GDScript_formatter/plugin.cfg", "res://addons/ProCam2D/plugin.cfg", "res://addons/ShakeNode2D/plugin.cfg")

[global_group]

spawnpoint=""
player=""

